# Copy to `.env` (next to docker-compose.yml) and fill in. `.env` is git-ignored.
# Only used by docker compose; running the app locally with `node index.js` /
# `npm run dev` keeps reading server/.env exactly as before.

# --- required ---------------------------------------------------------------
# Keep it URL-safe (letters, digits, - _ .) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-db-password
# Long random string used to sign login tokens, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- where things are published (defaults shown) -----------------------------
# CLIENT_PORT=5173
# SERVER_PORT=5000
# Browser-visible origin of the client; must match CLIENT_PORT. Used for CORS.
# CLIENT_URL=http://localhost:5173
# Browser-visible URL of the API; baked into the client bundle at build time.
# PUBLIC_API_URL=http://localhost:5000
# Number of reverse-proxy hops in front of the API (so rate limits see real IPs).
# TRUST_PROXY=1
# Set to 1 to stop the server applying server/db/schema.sql on startup.
# SKIP_AUTO_MIGRATE=1

# --- optional integrations (features degrade gracefully when empty) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
