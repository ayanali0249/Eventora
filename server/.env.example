# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/eventora
# PGUSER=postgres
# PGHOST=localhost
# PGDATABASE=eventora
# PGPASSWORD=your_db_password
# PGPORT=5432

# Authentication
# Secret used to sign JWTs (generate using: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# Optional: Reverse Proxy & Migration flags
# TRUST_PROXY=1
# SKIP_AUTO_MIGRATE=1

# Optional Integrations (degrade gracefully when omitted)
# Cloudinary (for image & chat attachment uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (for AI Event Planner & AI Assistant Chatbot)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_TIMEOUT_MS=12000
